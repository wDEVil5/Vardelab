# Supabase — completar con los valores de `npx supabase start` (local)
# o del proyecto hosted (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — NUNCA exponer en el cliente ni commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para sitemap, robots y enlaces absolutos.
# En local puede quedar vacía (cae a http://localhost:3000). En producción,
# la URL real (ej. https://vardelab.cl).
NEXT_PUBLIC_SITE_URL=

# Solo servidor — API key de Brevo (app.brevo.com → SMTP & API) para el
# correo transaccional de notificaciones. Sin esto, los correos simplemente
# no se envían (se loguea un error) pero nada se rompe.
BREVO_API_KEY=

# Solo servidor — protege app/api/cron/hitos-por-vencer (M97): el mismo valor
# debe quedar guardado en Postgres como `app.settings.cron_webhook_secret`
# (ver supabase/seed.sql para el valor de desarrollo local). Sin esto, el
# webhook devuelve 401 y el correo de "hito por vencer" no se envía (las
# notificaciones in-app se siguen creando igual).
CRON_WEBHOOK_SECRET=

# Pública — DSN del proyecto en sentry.io (Settings → Client Keys) para
# reportar errores de producción. Sin esto, Sentry queda desactivado y nada
# se rompe (ver instrumentation.ts / instrumentation-client.ts).
NEXT_PUBLIC_SENTRY_DSN=

# Solo build en CI/Vercel — token de sentry.io (Settings → Auth Tokens) y los
# slugs de org/proyecto, para subir source maps y que los stack traces de
# producción se vean legibles. Opcional: sin esto el build igual funciona.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
