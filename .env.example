# Supabase — completar con los valores de `npx supabase start` (local)
# o del proyecto hosted (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — NUNCA exponer en el cliente ni commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, para sitemap, robots y enlaces absolutos.
# En local puede quedar vacía (cae a http://localhost:3000). En producción,
# la URL real (ej. https://campuslab.cl).
NEXT_PUBLIC_SITE_URL=
